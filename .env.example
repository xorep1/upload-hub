# ---- App ----
APP_NAME="OTP Auth Service"
DEBUG=true

# ---- Database (SQLite) ----
DATABASE_URL="sqlite:///./otp_auth.db"

# ---- Redis ----
REDIS_URL="redis://localhost:6379/0"

max_session = 3

# ---- JWT ----
SECRET_KEY="CHANGE_ME_super_secret_key_please_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- OTP ----
OTP_LENGTH=6
OTP_TTL_SECONDS=120          # otp validity (2 min)
OTP_RESEND_COOLDOWN=60       # min seconds between two otp requests
OTP_MAX_ATTEMPTS=5           # max wrong tries before invalidation
REGISTRATION_TTL_SECONDS=600 # how long pending registration data is kept (10 min)

# ---- Object storage (ArvanCloud, S3-compatible) ----
S3_ENDPOINT_URL="https://hot.ir-central1.arvanstorage.ir"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_BUCKET="your-bucket-name"
S3_REGION="default"
S3_ADDRESSING_STYLE="virtual"   # "virtual" (Arvan default) or "path"
S3_PUBLIC_READ="false"          # true = permanent public links; false = presigned
MAX_UPLOAD_BYTES=209715200         # per-file upload limit (200 MB)
BUCKET_QUOTA_BYTES=5368709120      # total bucket quota shown in admin (5 GB)
DOWNLOAD_URL_TTL_SECONDS=3600      # presigned download link lifetime
